# Copy this file to .env and change JWT_SECRET.
# Local Postgres from docker-compose (when running the API outside Docker):
DATABASE_URL=postgresql://fittrack:fittrack@localhost:5432/fittrack
TEST_DATABASE_URL=postgresql://fittrack:fittrack@localhost:5432/fittrack_test

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of origins allowed to call the API (web app dev server, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
